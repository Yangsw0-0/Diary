{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vitest/globals", "@testing-library/jest-dom", "node"],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["tests/**/*.ts", "tests/**/*.tsx"]
}
